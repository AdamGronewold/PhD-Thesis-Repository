material Wall
{
  technique
  {
    pass
    {
      texture_unit
      {
        
        texture ../textures/wall.jpg // Relative to the location of the material script
        scale 1 1
      }
    }
  }
}

material Surface
{
  technique
  {
    pass
    {
      texture_unit
      {
        
        texture ../textures/surface.jpg
        scale 0.05 0.05
      }
    }
  }
}

