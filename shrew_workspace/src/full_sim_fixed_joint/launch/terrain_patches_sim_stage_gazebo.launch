<?xml version="1.0"?>
<launch>
	<!--Use this launch file to launch the stage for the Gazebo simulation w/o robots-->
	<!-- arguments you can pass this launch file, for example paused:=true -->
	<arg name="paused" default="false"/>
	<arg name="use_sim_time" default="true"/>
	<arg name="gui" default="true"/>
	<arg name="headless" default="false"/>
	<arg name="debug" default="false"/>

	<!-- Assume empty_world.launch login, with different name to launch, where envir is specified -->
	<include file="$(find gazebo_ros)/launch/empty_world.launch">
		<arg name="world_name" value="$(find full_sim)/worlds/terrain_sim_stage.world"/>
		<arg name="debug" value="$(arg debug)" />
		<arg name="gui" value="$(arg gui)" />
		<arg name="paused" value="$(arg paused)"/>
		<arg name="use_sim_time" value="$(arg use_sim_time)"/>
		<arg name="headless" value="$(arg headless)"/>
	</include>

	<!-- Load the terrain into the ROS Parameter Server; -->
	<param name="terrain_description" command="$(find xacro)/xacro '$(find terrain_patches)/urdf/terrain_patches.urdf.xacro' robot_namespace:=terrain_patches" />

	<!-- Run a python script to the send a service call to gazebo_ros to spawn the URDF model-->
	<node name="spawn_terrain" pkg="gazebo_ros" type="spawn_model" respawn="false" output="screen"
    args="-urdf -model terrain_patches -param terrain_description"/>
</launch>
